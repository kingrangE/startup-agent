# Existing OpenAI CLI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o

# Research providers. Google requires a Programmable Search Engine.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Research-backed agent defaults to the local SKT A.X 4.0 Light model.
SEPARK_LLM_PROVIDER=ax
AX_MODEL_ID=skt/A.X-4.0-Light
AX_DEVICE_MAP=auto
AX_MAX_NEW_TOKENS=4096

# Multilingual BGE cross-encoder used after Google/DDG retrieval.
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
